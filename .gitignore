# LibMatch .gitignore
# 큰 데이터 파일 및 모델 파일 제외

# Python 캐시
__pycache__/
*.py[cod]
*$py.class
*.so

# 데이터 파일 (큰 파일들)
data/*.pkl
data/*.pickle
data/*.p
data/*.json

# 하지만 익명화된 CSV 파일들은 포함 (공개용)
!data/*_anonymized.csv
!data/library_similarity_ranking.csv

# data/README.md는 추적
!data/README.md

# 모델 파일들 - Fine-tuned model is included via Git LFS
# *.safetensors files are tracked by Git LFS
*.bin
*.pt
*.pth

# 임시 파일
*.swp
*.swo
*~
.DS_Store

# 테스트 결과
*.log

# 결과 디렉토리 (자동 생성됨)
results/

# 환경 변수
.env
.env.local
.env.*

# IDE 설정
.vscode/
.idea/
*.code-workspace


